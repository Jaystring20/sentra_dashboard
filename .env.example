# ---- Google Sheets (recommended) -------------------------------------------
# URL of the Apps Script web app deployed from google-sheets/Code.gs
# (ends in /exec). Leave blank to run Sentra on built-in demo data.
VITE_SHEETS_API_URL=
# Same value as the SENTRA_TOKEN script property. Needed to save status changes.
VITE_SHEETS_TOKEN=
# How often Sentra checks the sheet for new rows (seconds, minimum 10)
VITE_SHEETS_POLL_SECONDS=30

# ---- Supabase (alternative; ignored when VITE_SHEETS_API_URL is set) -------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FEEDBACK_TABLE=feedback
VITE_SUMMARY_TABLE=executive_summaries
