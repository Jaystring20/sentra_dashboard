# Supabase connection (the database n8n writes processed feedback into).
# Leave blank to run Sentra on built-in demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Table that holds analyzed feedback records (see supabase/schema.sql)
VITE_FEEDBACK_TABLE=feedback
# Optional table holding AI executive summaries generated by n8n
VITE_SUMMARY_TABLE=executive_summaries
